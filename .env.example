# Copy to .env and fill in. See docs/DEPLOYMENT.md for the full reference
# of every variable, what it's for, and how to obtain it.

NODE_ENV=development
DEMO_MODE=true
# Set true to use the real Fabric REST API while everything else (sign-in,
# Graph, mail, calendar) stays in demo mode. Requires FABRIC_TENANT_ID and
# FABRIC_SERVICE_PRINCIPAL_CLIENT_ID/_SECRET below. Ignored once DEMO_MODE=false
# (Fabric is always real then).
FABRIC_LIVE_MODE=false

# TESTING ONLY — the appointment-confirmed deployment gate is otherwise
# mandatory and unbypassable by design (see docs/ARCHITECTURE.md). Both must
# be set together: SKIP_APPOINTMENT_GATE for server-side enforcement,
# NEXT_PUBLIC_SKIP_APPOINTMENT_GATE so the wizard's Create button isn't
# stuck disabled. Never set either in a real deployment.
SKIP_APPOINTMENT_GATE=false
NEXT_PUBLIC_SKIP_APPOINTMENT_GATE=false

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneclick_fabric?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Microsoft Entra ID app registration for platform/customer sign-in.
# Required for anything beyond demo mode.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Microsoft Fabric — never hardcode these, always via environment.
FABRIC_API_BASE_URL="https://api.fabric.microsoft.com/v1"
FABRIC_TENANT_ID=
FABRIC_WORKSPACE_ID=
FABRIC_DEFAULT_FOLDER_ID=
# Capacity newly-created customer workspaces get assigned to — required for
# real provisioning (a workspace with no capacity can't host any items).
FABRIC_CAPACITY_ID=
FABRIC_SERVICE_PRINCIPAL_CLIENT_ID=
FABRIC_SERVICE_PRINCIPAL_CLIENT_SECRET=

# Microsoft Graph — leave the GRAPH_* service principal vars unset to reuse
# the FABRIC_SERVICE_PRINCIPAL_* app registration (common case: one Entra
# app registration holds both Fabric and Graph permissions). Set them only
# when Graph uses a separate app registration.
GRAPH_API_BASE_URL="https://graph.microsoft.com/v1.0"
GRAPH_TENANT_ID=
GRAPH_SERVICE_PRINCIPAL_CLIENT_ID=
GRAPH_SERVICE_PRINCIPAL_CLIENT_SECRET=

# Secret vault (production: Azure Key Vault)
KEY_VAULT_URL=

# Mail: mock | smtp | graph
MAIL_PROVIDER=mock
MAIL_FROM_ADDRESS="noreply@oneclick-fabric.example"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Calendar: mock | graph
CALENDAR_PROVIDER=mock

# Connections Hub — generic OAuth2 "Connect" flow. Only needed for real
# (non-demo) OAuth-authenticated connectors; state signing reuses AUTH_SECRET.
CONNECTION_OAUTH_CLIENT_ID=
CONNECTION_OAUTH_CLIENT_SECRET=
CONNECTION_OAUTH_AUTHORIZATION_ENDPOINT=
CONNECTION_OAUTH_TOKEN_ENDPOINT=
CONNECTION_OAUTH_REDIRECT_URI="http://localhost:3000/api/connections/oauth/callback"
CONNECTION_OAUTH_SCOPE=offline_access
