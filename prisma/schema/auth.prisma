// Authentication (Auth.js / NextAuth with the Microsoft Entra ID provider
// and the Prisma adapter). A single User table covers both internal
// platform staff and external customer principals — internal roles are
// set directly on `role`; external users additionally get a CustomerUser
// membership row (see customer.prisma) carrying their customer-scoped role.

enum PlatformRole {
  platform_admin
  service_agent
  operations
  customer_admin
  customer_user
}

model User {
  id            String       @id @default(cuid())
  entraObjectId String?      @unique
  email         String       @unique
  name          String?
  image         String?
  role          PlatformRole @default(customer_user)
  isActive      Boolean      @default(true)
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  customerMemberships CustomerUser[]
  serviceAgent        ServiceAgent?

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
