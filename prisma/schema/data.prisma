// Resolved from Lakehouse.properties.sqlEndpointProperties (see
// docs/FABRIC_API.md §5) once a Gold Lakehouse's SQL Analytics Endpoint
// finishes provisioning. Never stores credentials — auth is Entra ID.
model SqlEndpoint {
  id         String @id @default(cuid())
  customerId String

  fabricWorkspaceId String
  fabricLakehouseId String

  server           String
  database         String
  connectionString String // non-secret; Entra-authenticated connection string

  provisioningStatus String  @default("InProgress") // mirrors Fabric's InProgress|Success|Failed
  readOnly           Boolean @default(true)

  exposedInPortal        Boolean @default(false)
  includedInWelcomeEmail Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([fabricLakehouseId])
  @@index([customerId])
}

// One row per customer describing which KPIs their Customer Usage Report
// surfaces. The report itself is generated by the Monitoring Collector /
// Customer Filter pipeline (services/monitoring) — never by querying the
// shared Fabric Capacity Metrics app directly (that would leak
// cross-customer capacity data; see docs/FABRIC_API.md §6).
model MonitoringConfiguration {
  id         String @id @default(cuid())
  customerId String

  enabled Boolean @default(false)

  showServiceStatus     Boolean @default(true)
  showDataFreshness     Boolean @default(true)
  showRefreshSuccess    Boolean @default(true)
  showUsageTrend        Boolean @default(false)
  showAdvancedTechnical Boolean @default(false)

  operationalAlertsEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId])
}

// The lightweight, business-facing "Available Data" catalog entry a
// customer sees — deliberately excludes pipeline/notebook/lineage
// internals (see section 22).
model DatasetCatalogEntry {
  id         String @id @default(cuid())
  customerId String

  name                String
  businessDescription String?
  layer               String    @default("gold")
  lastUpdatedAt       DateTime?
  refreshFrequency    String?
  availableViaSql     Boolean   @default(false)
  availableViaReport  Boolean   @default(false)

  desiredResourceLogicalName String? // internal linkage, never shown to the customer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Lets services/monitoring/dataset-catalog.ts's syncDatasetCatalog()
  // upsert idempotently instead of accumulating duplicate rows on every
  // sync. Postgres treats NULLs as distinct for uniqueness purposes, so
  // manually-created entries without desiredResourceLogicalName (never
  // synced from a DesiredResource) are unaffected by this constraint.
  @@unique([customerId, desiredResourceLogicalName])
  @@index([customerId])
}
